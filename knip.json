{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@stryker-mutator/api", "@arethetypeswrong/cli"],
  "workspaces": {
    ".": {
      "entry": ["test/**/*.test.ts"]
    },
    "packages/cli": {
      "entry": ["src/index.ts", "src/**/*.test.ts"]
    },
    "packages/*": {
      "entry": ["src/**/*.test.ts"]
    }
  },
  "ignoreFiles": ["fixtures/**"]
}
