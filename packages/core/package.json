{
  "name": "@neukee/core",
  "version": "0.0.0",
  "description": "Neukee report types, JSON Schema, validator and rule catalog loader.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neukee/neukee.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/neukee/neukee#readme",
  "bugs": "https://github.com/neukee/neukee/issues",
  "type": "module",
  "exports": {
    ".": {
      "@neukee/source": "./src/index.ts",
