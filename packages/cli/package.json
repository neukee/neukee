{
  "name": "@neukee/cli",
  "version": "0.0.0",
  "description": "Neukee CLI: find what breaks before you upgrade Node.js or Next.js.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neukee/neukee.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/neukee/neukee#readme",
  "bugs": "https://github.com/neukee/neukee/issues",
  "type": "module",
  "bin": {
    "neukee": "./dist/index.js"
  },
  "files": [
    "catalog",
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@neukee/core": "workspace:*",
    "@neukee/scanner": "workspace:*"
  }
}
